# Production inputs of the website (erp-docs/docs/74 §3). Public values only — Vite inlines every VITE_* into the page,
# so never put a secret here. Leave a value blank rather than invent it: `npm run build` (production) refuses to build
# while a required one is blank, malformed, not HTTPS or a test value; `npm run build:preview` shows marked test values.

# Where the site and the API live (HTTPS only in production; no trailing slash on origins).
VITE_PUBLIC_SITE_ORIGIN=
VITE_ADMIN_SITE_ORIGIN=
# The API base including /api/v1. Blank in development: the page's own hostname on port 3010 (docs/38).
VITE_API_BASE=

# The organization (TSX-MR supplies every value; nothing is guessed).
VITE_ORGANIZATION_DISPLAY_NAME=TSX-MR
VITE_ORGANIZATION_LEGAL_NAME=
VITE_ORGANIZATION_LEGAL_FORM=
VITE_ORGANIZATION_REGISTRATION_NUMBER=
VITE_ORGANIZATION_COUNTRY=Mauritania
VITE_ORGANIZATION_CITY=
VITE_ORGANIZATION_ADDRESS=
VITE_ORGANIZATION_PHONE=

# Contacts.
VITE_SUPPORT_EMAIL=
VITE_PRIVACY_EMAIL=
VITE_COMMERCIAL_EMAIL=
VITE_SECURITY_EMAIL=
VITE_SUPPORT_WHATSAPP=

# Store listings — only once the app is published there.
VITE_APPLE_APP_STORE_URL=
VITE_GOOGLE_PLAY_URL=

# The account-deletion verification channel, set ONLY once it is configured and tested in production: whatsapp.
VITE_ACCOUNT_DELETION_CHANNEL=
# Effective date of the approved privacy policy and terms (YYYY-MM-DD).
VITE_LEGAL_EFFECTIVE_DATE=
