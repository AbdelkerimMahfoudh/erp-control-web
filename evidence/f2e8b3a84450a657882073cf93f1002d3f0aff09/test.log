. Each is%0A//    rendered at an address of its own directory, so the page that hydrates it at the real address renders the same.%0Alet notFound = 0;%0Aif (portal) {%0A  // The portal's root is sent on to its Owner page (`_redirects`); its index is the shell all the same, never the%0A  // unrendered template, for a host that serves the file first.%0A  write('index.html', shell('Dukan ERP'));%0A  write('404.html', shell(`${ssr.translate('en', 'notFound.title')} — Dukan ERP`));%0A  notFound++;%0A}%0Afor (const lang of portal ? [] : ssr.LANGUAGES) {%0A  const prefix = lang === 'en' ? '' : `/${lang}`;%0A  const head = `<title>${esc(`${ssr.translate(lang, 'notFound.title')} — ${ssr.SITE.displayName}`)}</title>\\n    <meta name=\"robots\" content=\"noindex, nofollow\" />`;%0A  for (const dir of [prefix, `${prefix}/in-app`]) {%0A    write(`${dir.slice(1)}${dir ? '/' : ''}404.html`, page(lang, head, ssr.render(`${dir}/404`, lang)));%0A    notFound++;%0A  }%0A}%0A%0A// 4. The generated files.%0Aconst builtAt = new Date();%0Awrite('robots.txt', ssr.robotsTxt(ssr.SITE, ssr.IS_PREVIEW));%0Aif (ssr.SITE.publicSiteOrigin && !portal) write('sitemap.xml', ssr.sitemapXml(ssr.SITE, builtAt.toISOString().slice(0, 10)));%0Awrite('_headers', ssr.headersFile(ssr.SITE, ssr.IS_PREVIEW));%0Awrite('_redirects', ssr.redirectsFile(ssr.SITE));%0Aconst security = ssr.securityTxt(ssr.SITE, builtAt);%0Aif (security && ssr.SURFACE !== 'admin') write('.well-known/security.txt', security);%0A// The manifest's colours are the light theme's background and text (theme/tokens.css).%0Awrite('site.webmanifest', ssr.webManifest(ssr.SITE, '#172033', '#f7f8fb'));%0A%0Aconsole.log(`prerendered ${pages} pages and ${notFound} not-found pages (${ssr.LANGUAGES.length} languages), mode ${ssr.BUILD_MODE}, surface ${ssr.SURFACE}${ssr.IS_PREVIEW ? ' — PREVIEW: test values, noindex' : ''}`);%0A"%0A%0A ❯ test/portal-surface.test.ts:132:23%0A%0A
