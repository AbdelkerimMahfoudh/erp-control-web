nto them, reaches its bundle.%0A */%0Afunction surfaceAliases(mode: string) {%0A  const surface = surfaceOf(loadEnv(mode, process.cwd(), 'VITE_').VITE_SITE_SURFACE);%0A  const stub = (path: string) => fileURLToPath(new URL(path, import.meta.url));%0A  if (surface === 'portal') {%0A    const areas = [{ find: /^\\.\\/public-areas$/, replacement: stub('./src/public-areas.portal.tsx') }];%0A    // D227: the customers' portal holds no console. The password-protected test site is a preview build and keeps it.%0A    if (mode === 'production') {%0A      areas.push({ find: /^(\\.{1,2}\\/)+protected-areas$/, replacement: stub('./src/protected-areas.owner.tsx') });%0A    }%0A    return areas;%0A  }%0A  if (surface !== 'public') return [];%0A  return [%0A    // Any depth: `components/RouteScroll.tsx` asks from one level down (`../protected-areas`).%0A    { find: /^(\\.{1,2}\\/)+protected-areas$/, replacement: stub('./src/protected-areas.public.tsx') },%0A    { find: /^(\\.{1,2}\\/)+api\\/client$/, replacement: stub('./src/api/client.public.ts') },%0A    { find: /^(\\.{1,2}\\/)+components\\/PlanPricing$/, replacement: stub('./src/components/PlanPricing.public.tsx') },%0A    { find: /^\\.\\/pages\\/public\\/Apply$/, replacement: stub('./src/pages/public/Apply.public.tsx') },%0A  ];%0A}%0A%0A/**%0A * The inputs as this build reads them, computed here and inlined (`config/site.ts`), so the page carries its values%0A * and not the table of rules and preview values that produced them: a production bundle holds no test value at all.%0A */%0Afunction siteInputs(mode: string) {%0A  const buildMode: BuildMode = mode === 'production' || mode === 'development' || mode === 'test' ? mode : 'preview';%0A  return { __SITE_INPUTS__: JSON.stringify({ mode: buildMode, ...readInputs(loadEnv(mode, process.cwd(), 'VITE_'), buildMode) }) };%0A}%0A%0Aexport default defineConfig(({ mode }) => ({%0A  plugins: [react(), releaseGuard(), portalIcons(mode)],%0A  resolve: { alias: surfaceAliases(mode) },%0A 